{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd MobileShop.Web && npm install && npm run build",
  "outputDirectory": "MobileShop.Web/dist/mobile-shop-web/browser",
  "framework": "angular",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
